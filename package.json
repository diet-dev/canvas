{
  "name": "@dietdev/canvas",
  "version": "0.1.0",
  "description": "DPR-обёртка над Canvas 2D и минимальный игровой стек: игровой цикл, эффекты, интерактивные объекты, вьюпорт",
  "keywords": [
    "canvas",
    "canvas2d",
    "2d",
    "game",
    "game-loop",
    "dpr",
    "effects",
    "viewport",
    "typescript"
  ],
  "author": "dietdev <dietdev.tech@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diet-dev/canvas.git"
  },
  "homepage": "https://github.com/diet-dev/canvas#readme",
  "bugs": {
    "url": "https://github.com/diet-dev/canvas/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test:watch": "node --disable-warning=ExperimentalWarning --test --watch \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "eslint src test --fix",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.37.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "gts": "^7.0.0"
  },
  "dependencies": {
    "@dietdev/emitter": "^0.1.0"
  }
}
